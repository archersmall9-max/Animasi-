  "true_peak": -1.0,
  "loudnorm_passes": 2,
  "audio_fade": 0.25,
  "silent_track_if_missing": true,

  "crf": 17,
  "x264_preset": "slow",
  "max_bitrate": "28M",
  "bufsize": "56M",
  "audio_bitrate": "320k",
  "faststart": true,

  "notes": {
    "channel": "@Lowk67Tuff",
    "primary_platform": "YouTube Shorts",
    "metadata_language": "English",
    "usage": "viralcut edit SOURCE --config config/lowk67tuff-shorts.json -o exports/NAME.mp4",
    "no_captions": "Subtitles, on-screen text and voice-over are intentionally disabled.",
    "notes_on_smart_fill": "smart_max_aspect 1.2 keeps a 16:9 subject noticeably larger than a plain letterbox while still showing the whole frame."
  }
}
