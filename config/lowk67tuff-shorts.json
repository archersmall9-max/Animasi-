{
  "ratio": "9:16",
  "width": 1080,
  "height": 1920,
  "fps": 60,
  "interpolate": false,

  "fill": "auto",
  "focus_x": 0.5,
  "focus_y": 0.5,
  "blur_strength": 1.0,
  "bg_dim": 0.06,
  "pad_color": "black",
  "smart_max_aspect": 1.2,

  "zoom": "push",
  "zoom_amount": 0.05,
  "hook_seconds": 1.2,

  "grade": "clean",
  "sharpen": 1.05,
  "denoise": false,
  "stabilize": false,

  "start": null,
  "end": null,
  "max_duration": null,
  "speed": 1.0,

  "intro": "blurzoom",
  "intro_duration": 0.45,
  "outro": "blurout",
  "outro_duration": 0.7,

  "watermark_text": "@Lowk67Tuff",
  "watermark_image": null,
  "watermark_position": "top-left",
  "watermark_style": "shadow",
  "watermark_opacity": 0.88,
  "watermark_scale": 1.0,
  "watermark_margin_x": 0.05,
  "watermark_margin_y": 0.045,

  "keep_audio": true,
